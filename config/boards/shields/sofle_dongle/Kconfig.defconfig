if SHIELD_SOFLE_DONGLE

config ZMK_KEYBOARD_NAME
    default "Sofle Dongle"

# The dongle is the BLE central; both halves become peripherals.
config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Two peripherals: left half + right half.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Connection slots: 2 peripherals + up to 5 host (BT profile) connections.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
