 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * Sofle v2 layout adapted from a Charybdis Mini (QMK) layout.
 * Layer roles mirror the Charybdis:
 *   BASE  - QWERTY alphas, mods on thumbs
 *   FN    - F-keys, number row, window-management combos (was Charybdis L1)
 *   NAV   - navigation, copy/paste, volume (was Charybdis L2; trackball/mouse removed)
 *   SYM   - symbols, brackets, arrow cluster (was Charybdis L3)
 *   SETTINGS - Bluetooth / ZMK Studio / reset (FN + SYM held; the wireless
 *              Sofle needs BT controls the wired Charybdis did not)
 *
 * Differences from the Charybdis, by design:
 *   - No trackball: all mouse keys are dropped. On NAV the scroll-wheel cluster
 *     became an arrow cluster; mouse-button keys became &none.
 *   - The Sofle has a dedicated number row + extra thumb keys. The number row
 *     stays as 1-0; the extra thumbs add GUI/ALT/CTRL (mods the Charybdis lacked).
 *   - MACRO(0)/MACRO(1) from Charybdis L1 are &none placeholders (see FN row 3).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE     0
#define FN       1
#define NAV      2
#define SYM      3
#define SETTINGS 4

/ {
    behaviors {
        // Grave-Escape: tap = ESC, tap with Shift/GUI = ` (mirrors QMK KC_GESC)
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Hold FN (left thumb) + SYM (right thumb) -> SETTINGS
        settings_layer {
            if-layers = <FN SYM>;
            then-layer = <SETTINGS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  DEL  |
            // | GESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // |  CTRL |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | SFT/ENT | FN | NAV  |  | SPACE | SYM | CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4         &kp N5                        &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp DELETE
&gresc     &kp Q   &kp W     &kp E     &kp R          &kp T                         &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F          &kp G                         &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X     &kp C     &kp V          &kp B   &kp C_MUTE   &none     &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &mt LSHFT RET  &mo FN  &mo NAV      &kp SPACE &mo SYM    &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        fn_layer {
            label = "fn";

            // Charybdis L1: F-keys, number row, window-management combos.
            // ------------------------------------------------------------------------------------------------------------
            // | (num row passes through to base)                          |
            // | A+F4 |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | C+5  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |      |A+TAB|G+TAB|C+S+K | G+V  |G+S+S |        |  |       |MACR1 |       |       | G+.  |   \   | MACR0 |
            //               |    |     | C+A+SPACE | LSHFT |   |

            bindings = <
&trans      &trans       &trans       &trans         &trans      &trans                       &trans     &trans     &trans     &trans      &trans     &trans
&kp LA(F4)  &kp F1       &kp F2       &kp F3         &kp F4      &kp F5                       &kp F6     &kp F7     &kp F8     &kp F9      &kp F10    &kp F11
&kp LC(N5)  &kp N1       &kp N2       &kp N3         &kp N4      &kp N5                       &kp N6     &kp N7     &kp N8     &kp N9      &kp N0     &kp F12
&trans      &kp LA(TAB)  &kp LG(TAB)  &kp LC(LS(K))  &kp LG(V)   &kp LG(LS(S))  &trans &trans  &none      &none      &none      &kp LG(DOT) &kp BSLH   &none
                         &trans       &trans         &trans      &trans     &trans  &kp LC(LA(SPACE)) &kp LSHFT  &trans     &trans      &trans
            >;
            // Right row 3 outer keys: leftmost = MACRO(1), rightmost = MACRO(0).
            // Charybdis exported these as macros without contents -> &none placeholders.

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            label = "nav";

            // Charybdis L2: navigation, edit shortcuts, volume. Trackball/mouse removed:
            // the scroll-wheel cluster became an arrow cluster; mouse buttons -> &none.
            // ------------------------------------------------------------------------------------------------------------
            // |  `   |     | C+W |      | C+R  | C+T  |                   | VOL+ | PGUP  |  UP   | PGDN |   ^   |   ~   |
            // | C+TAB|  ^  | C+S |      |      |      |                   | VOL- |  <-   | DOWN  |  ->  |   ^   |   `   |
            // |      | C+Z | C+X | C+C  | C+V  |      |        |  |       | S+F12| C+PGUP|       |C+PGDN|   |   | SHIFT |
            //               |    | C+Z |      |      |      |  | S+ENTER |     |       |       |      |

            bindings = <
&trans       &trans     &trans     &trans     &trans     &trans                          &trans       &trans        &trans   &trans        &trans       &trans
&kp GRAVE    &none      &kp LC(W)  &none      &kp LC(R)  &kp LC(T)                       &kp C_VOL_UP &kp PG_UP     &kp UP   &kp PG_DN     &kp LS(N6)   &kp LS(GRAVE)
&kp LC(TAB)  &kp LS(N6) &kp LC(S)  &none      &none      &none                           &kp C_VOL_DN &kp LEFT      &kp DOWN &kp RIGHT     &kp LS(N6)   &kp GRAVE
&trans       &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none      &trans     &trans     &kp LS(F12)  &kp LC(PG_UP) &none    &kp LC(PG_DN) &kp LS(BSLH) &kp RSHFT
                        &trans     &trans     &kp LC(Z)  &trans     &trans     &kp LS(RET) &trans      &trans        &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            label = "sym";

            // Charybdis L3: symbols, brackets, arrow cluster, window shortcuts.
            // ------------------------------------------------------------------------------------------------------------
            // |  %  |  #  |  (  |  )   |  &   |  *   |                   |      | PGUP  |  UP   | PGDN |       |  DEL  |
            // |  $  |  !  |  =  |  -   |  {   |  }   |                   | HOME |  <-   | DOWN  |  ->  |  END  |       |
            // |     |  @  |  +  |  _   |  [   |  ]   |        |  |       | A+TAB| G+TAB | G+DN  |      |       |       |
            //               |    | ALT | GUI  |      |  |       |      |       |       |      |

            bindings = <
&trans      &trans      &trans     &trans      &trans     &trans                         &trans       &trans        &trans       &trans     &trans    &trans
&kp LS(N5)  &kp LS(N3)  &kp LS(N9) &kp LS(N0)  &kp LS(N7) &kp LS(N8)                     &none        &kp PG_UP     &kp UP       &kp PG_DN  &none     &kp DEL
&kp LS(N4)  &kp LS(N1)  &kp EQUAL  &kp MINUS   &kp LBRC   &kp RBRC                       &kp HOME     &kp LEFT      &kp DOWN     &kp RIGHT  &kp END   &trans
&trans      &kp LS(N2)  &kp KP_PLUS &kp UNDER  &kp LBKT   &kp RBKT   &trans     &trans    &kp LA(TAB)  &kp LG(TAB)   &kp LG(DOWN) &none      &none     &trans
                        &trans     &trans      &trans     &kp LALT   &kp LGUI   &trans    &trans       &trans        &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        settings_layer {
            label = "settings";

            // Held: FN + SYM. Bluetooth, ZMK Studio unlock, bootloader, reset.
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |               |     |     |     |     |     |        |
            // | STUDIO |       |       |       |       |       |               |     |     |     |     |     | BOOTL  |
            // | RESET  |       |       |       |       |       |               |     |     |     |     |     | RESET  |
            // | BOOTL  |       |       |       |       |       |     |  |       |     |     |     |     |     | BOOTL  |
            //                  |       |       |       |       |     |  |       |     |     |     |     |

            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none  &none  &none  &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none                         &none  &none  &none  &none  &none  &bootloader
&sys_reset      &none         &none         &none         &none         &none                         &none  &none  &none  &none  &none  &sys_reset
&bootloader     &none         &none         &none         &none         &none      &none     &none      &none  &none  &none  &none  &none  &bootloader
                              &trans        &trans        &trans        &trans     &trans    &trans     &trans &trans &trans &trans
            >;
        };
    };
};
